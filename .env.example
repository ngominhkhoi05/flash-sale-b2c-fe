# ==============================================================================
# Vibe Mart - Frontend (Flash Sale B2C) - Local env
# Copy file nay thanh .env.local va chinh sua gia tri phu hop.
# ==============================================================================

# Base API URL cua backend Spring Boot (REST + JWT)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# WebSocket STOMP endpoint (SockJS-compatible)
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# Bat/tat che do Mock Data cho FE (khi BE chua chay)
# CANH BAO QUAN TRONG: KHONG DUOC DAT true O MOI TRUONG CHAY THAT / PRODUCTION!
# Khi dat true: FE dung du lieu gia lap va tu dong bypass kiem tra xac thuc route /admin phuc vu phat trien giao dien.
NEXT_PUBLIC_USE_MOCKS=true

# Public site URL (dung cho SEO, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Locale mac dinh (vi | en)
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# Google OAuth2 redirect URI (PHẢI khop 100% voi `redirect_uri` trong consent URL
# + `google.oauth2.redirect-uri` o BE application-{profile}.yaml).
# ⚠️ Bat buoc dung prefix `NEXT_PUBLIC_` - bien khong co prefix nay se KHONG
# duoc Next.js inline vao browser bundle → client luon nhan `undefined`.
# Local dev:
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Production:
# NEXT_PUBLIC_GOOGLE_REDIRECT_URI=https://vibe-mart-utc2.canluaz.io.vn/auth/google/callback
