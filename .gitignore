# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/

# workspace
.superpowers/
coverage/
playwright-report/
test-results/
*.log

# local scripts (debug/convert helpers)
# Note: scripts/verify-rules.ps1 and scripts/snapshot-keywords.ps1 are committed
# (rule verification utilities). Other scripts/* remain local debug/convert helpers.
# 2026-10-09: added audit-workflow.* (pre-commit audit, see .cursor/rules/anti-drift-workflow.mdc)
/scripts/*
!/scripts/verify-rules.ps1
!/scripts/snapshot-keywords.ps1
!/scripts/audit-workflow.mjs
!/scripts/audit-workflow.test.mjs
!/scripts/audit-workflow.ps1
!/scripts/i18n-parity.test.mjs

# Scratch
.scratch/

# agent scratch downloads (Stitch/Figma reference assets, MCP tool dumps)
agent-tools/

# Stitch reference assets (downloaded HTML/PNG for design system, not source)
tmp/
